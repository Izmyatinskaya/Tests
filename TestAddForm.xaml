<Window x:Class="wpf_тесты_для_обучения.TestAddForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:wpf_тесты_для_обучения"
        mc:Ignorable="d"
        Title="Создание/Изменение теста"
        Width="950"
        Height="680"
        Background="{StaticResource WindowDefaultBackground}"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing" MinWidth="698" ScrollViewer.HorizontalScrollBarVisibility="Auto" 
        ScrollViewer.VerticalScrollBarVisibility="Auto">
    <Grid x:Name="myGrid">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*"/>
            <ColumnDefinition Name="columnGrid2" Width="2.5*"/>
        </Grid.ColumnDefinitions>

        <!-- Верхний блок: фиксированный TextBox и TextBlock -->
        <StackPanel Grid.Row="0" Grid.Column="0" Margin="30,30,30,10">
            <TextBox x:Name="titleTextBox"
                     Style="{StaticResource GreyTextBoxStyle}"
                     Text="Введите название теста ..."
                     PreviewMouseLeftButtonUp="titleTextBox_PreviewMouseLeftButtonUp"
                     TextChanged="titleTextBox_TextChanged"/>


        </StackPanel>

        <!-- Прокручиваемая область -->
        <Border Style="{StaticResource LightBorder}"  
Margin="30,80,30,30"
Grid.Column="0" Grid.Row="0" Padding="15,10,0,10">
            <ScrollViewer Grid.Column="0"  VerticalScrollBarVisibility="Auto" Grid.RowSpan="3" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="questionsStackPanel" Width="Auto" HorizontalAlignment="Stretch">
                    <!--Здесь будут блоки вопросов-->
                </StackPanel>
                <!--<DockPanel x:Name="questionsStackPanel"   HorizontalAlignment="Stretch">
                
            </DockPanel>-->
            </ScrollViewer>
        </Border>

        <!-- Правый столбец (без изменений) -->
        <Border Style="{StaticResource LightBorder}"  
        Margin="0" 
        Grid.Column="1"  Padding="15,10,15,0">
            <StackPanel Margin="10,0,10,10" Visibility="{Binding ViewMode}">
                <TextBlock Style="{StaticResource BoldTextStyle}" Margin="0,0,0,5" >
                Нажмиет на кнопку, чтобы создать вопрос
                </TextBlock>
                <Button Content="1 ответ" Style="{StaticResource AddQuestionButtonStyle}" Click="Button_Click_1"  Tag="check-circle.jpg" Margin="0,0,0,5"/>
                <Button Content="множественный выбор"  Style="{StaticResource AddQuestionButtonStyle}" Click="Button_Click"  Tag="check-square.jpg" Margin="0,0,0,5"/>
                <Button Content="1 ответ с картинкой" Style="{StaticResource AddQuestionButtonStyle}" Click="Button_Click_2"   Tag="check-circle-image.jpg" Margin="0,0,0,5"/>
                <Button Content="множественный выбор с картинкой" Style="{StaticResource AddQuestionButtonStyle}" Click="Button_Click_3" Tag="check-square-image.jpg" Margin="0,0,0,5" />


                <!--<Separator Margin="15,5,15,10"></Separator>-->
                <TextBlock Style="{StaticResource BoldTextStyle}" Margin="0,10,0,5" >
               Введите порог прохождения теста, %
                </TextBlock>
                <TextBox Name="completedPercentTextBox"
                 Style="{StaticResource GreyTextBoxStyle}"
                 Height="34"
                 BorderBrush="#FFABADB3"
                 BorderThickness="1"
                 PreviewTextInput="CompletedPercentTextBox_PreviewTextInput"
                 LostFocus="CompletedPercentTextBox_LostFocus">
                    <TextBox.Text>
                        <Binding Path="CompletionPercentage"
                         Mode="TwoWay"
                         UpdateSourceTrigger="LostFocus"
                         FallbackValue="0.00">
                            <Binding.ValidationRules>
                                <local:PercentageValidationRule MinValue="0.00" MaxValue="100.00"/>
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>

                    <Validation.ErrorTemplate>
                        <ControlTemplate>
                            <DockPanel>
                                <TextBlock Foreground="Red" FontSize="10" FontWeight="Bold" Margin="5,0,0,0"
                                   DockPanel.Dock="Right"
                                   Text="{Binding ElementName=adornedElement, Path=AdornedElement.(Validation.Errors)[0].ErrorContent}"/>
                                <AdornedElementPlaceholder x:Name="adornedElement"/>
                            </DockPanel>
                        </ControlTemplate>
                    </Validation.ErrorTemplate>
                </TextBox>
                <!--<TextBox Name="completedPercentTextBox"
                         Style="{StaticResource GreyTextBoxStyle}"
            Height="34"
                         Text="Пример: 10"
            BorderBrush="#FFABADB3"
            BorderThickness="1" />-->
                <!-- Раздел выбора должностей -->
                <TextBlock Style="{StaticResource BoldTextStyle}" Margin="0,10,0,5" >
                Укажите должности, проходящие тест
                </TextBlock>
                <ListBox Name="rolesListBox" MaxHeight="115" Margin="0,0,0,10">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Title}" Style="{StaticResource OrangeCheckBoxStyle}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Content="Готово"
                    Style="{StaticResource OrangeButtonStyle}"
                    FontSize="20"
                    Click="Button_Click_4" Height="42"
                    />

                <TextBlock x:Name="ErrorTextBlock" TextWrapping="Wrap" Foreground="Red" Visibility="Collapsed" Margin="0,0,0,5"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>
